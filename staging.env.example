# Copy to staging.env for a disposable or owner-authorized staging project.
# Never reuse production database/Auth/Storage credentials or guest data.
TEN29_ENVIRONMENT=staging
TEN29_STAGING_ACCESS_USER=staging-reviewer
TEN29_STAGING_ACCESS_PASSWORD=generate-a-random-password-at-least-24-characters
NEXT_PUBLIC_SITE_URL=https://staging.example.invalid
NEXT_PUBLIC_SITE_NAME="TEN29 Staging (TEST)"
TEN29_STAGING_SUPABASE_PROJECT_REF=staging-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# Use only a Resend test-mode key and sink recipient in disposable testing.
RESEND_API_KEY=re_test_replace-me
INQUIRY_NOTIFICATION_TO=staging-sink@example.invalid
INQUIRY_FROM_EMAIL=TEN29 Staging <staging@example.invalid>

# Configure these only when the staging project and owner test identity exist.
NEXT_PUBLIC_ENABLE_OWNER_PREVIEW=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=

# Copy to .env.local for local development. Replace only with local Supabase CLI values.
# This template contains no credentials. Never commit .env.local.
TEN29_ENVIRONMENT=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="TEN29 Holiday Homes LOCAL TEST"

# Optional public contact/social values. Keep blank unless the local test needs them.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_PUBLIC_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_ENABLE_OWNER_PREVIEW=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Local Supabase only. Obtain these from the local Supabase CLI after starting the stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Keep mail disabled locally; when exercising email, use a test-mode provider and sink only.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_TO=ten29-test@example.invalid
INQUIRY_FROM_EMAIL="TEN29 Local <local@example.invalid>"
PRIVACY_CONTACT_EMAIL=

# Optional media executable overrides; blank uses the executable name from PATH.
TEN29_FFMPEG_PATH=
TEN29_FFPROBE_PATH=
TEN29_HEIF_INFO_PATH=
TEN29_HEIF_CONVERT_PATH=
